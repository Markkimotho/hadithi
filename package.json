{
  "name": "hadithi",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs dist",
    "test:browser": "npm run build && playwright test",
    "eval": "node evals/playtest.mjs",
    "verify": "npm test && npm run build && npm run eval"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
